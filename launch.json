    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FutureMe App",
            "type": "pwa-node",
            "request": "launch",
            "program": "${workspaceFolder}/futureme/backend/server.js",
            "cwd": "${workspaceFolder}/futureme/backend",
            "envFile": "${workspaceFolder}/futureme/backend/.env",
            "serverReadyAction": {
                "pattern": "Local URL: (http://localhost:\\d+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}